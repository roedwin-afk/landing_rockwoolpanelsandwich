---
import { getLang, useTranslations } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const lang = getLang(Astro.url, base);
const t = useTranslations(lang);

type FaqItem = { q: string; a: string };
const items: FaqItem[] = t.faq.items as unknown as FaqItem[];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
};
---

<BaseLayout t={t} lang={lang}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
    slot="head"
  />

  <main class="faq-page">

    <section class="page-hero">
      <div class="container">
        <div class="page-hero-inner reveal">
          <span class="page-label">{t.faq.label}</span>
          <h1 class="page-title">{t.faq.title}</h1>
          <p class="page-desc">{t.faq.desc}</p>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <div class="container">
        <div class="faq-list">
          {items.map((item, i) => (
            <div class="faq-item reveal" data-index={i}>
              <button class="faq-question" aria-expanded="false">
                <span>{item.q}</span>
                <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </button>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="faq-cta">
      <div class="container">
        <div class="cta-inner reveal">
          <h2 class="cta-title">{t.comparisonPage.cta.title}</h2>
          <p class="cta-desc">{t.comparisonPage.cta.desc}</p>
          <div class="cta-btns">
            <a href={`${base}/es/contact`} class="btn-primary">
              {t.comparisonPage.cta.btnContact}
            </a>
            <a href={`${base}/es/performance`} class="btn-secondary">
              {t.comparisonPage.cta.btnSpecs}
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<script is:inline>
  function initFaq() {
    const buttons = document.querySelectorAll(".faq-question");
    if (!buttons.length) return;

    buttons.forEach(function(btn) {
      if (btn.dataset.faqReady) return;
      btn.dataset.faqReady = "1";

      const item = btn.closest(".faq-item");
      const answer = item && item.querySelector(".faq-answer");
      if (answer) answer.style.height = "0px";
      btn.setAttribute("aria-expanded", "false");

      btn.addEventListener("click", function() {
        const isOpen = btn.getAttribute("aria-expanded") === "true";
        const allBtns = document.querySelectorAll(".faq-question");

        // Close all
        allBtns.forEach(function(b) {
          const a = b.closest(".faq-item") && b.closest(".faq-item").querySelector(".faq-answer");
          b.setAttribute("aria-expanded", "false");
          b.closest(".faq-item") && b.closest(".faq-item").classList.remove("open");
          if (a) a.style.height = "0px";
        });

        // Open if it was closed
        if (!isOpen) {
          const thisItem = btn.closest(".faq-item");
          const thisAnswer = thisItem && thisItem.querySelector(".faq-answer");
          btn.setAttribute("aria-expanded", "true");
          thisItem && thisItem.classList.add("open");
          if (thisAnswer) thisAnswer.style.height = thisAnswer.scrollHeight + "px";
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initFaq);
</script>

<style>
  .faq-page { background-color: var(--color-bg); }

  .page-hero {
    background-color: var(--color-dark);
    padding-block: var(--space-24);
    padding-top: calc(var(--space-24) + var(--nav-height));
  }

  .page-hero-inner { max-width: 48rem; }

  .page-label {
    display: inline-block;
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    margin-bottom: var(--space-4);
    background-color: rgba(249, 115, 22, 0.1);
    border: 1px solid rgba(249, 115, 22, 0.2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  .page-title {
    font-size: var(--text-5xl);
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .page-desc {
    font-size: var(--text-lg);
    color: #94a3b8;
    line-height: 1.7;
    max-width: 40rem;
  }

  .faq-section {
    padding-block: var(--space-24);
    background-color: var(--color-bg);
  }

  .faq-list {
    /* max-width: 52rem; */
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .faq-item:hover { border-color: rgba(249, 115, 22, 0.35); }

  .faq-item.open {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px rgba(249, 115, 22, 0.15);
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6);
    text-align: left;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    background: none;
    border: none;
    font-family: var(--font-sans);
    line-height: 1.4;
    transition: color var(--transition-fast);
  }

  .faq-question:hover { color: var(--color-primary); }
  .faq-item.open .faq-question { color: var(--color-primary); }

  .faq-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform var(--transition-base), color var(--transition-fast);
  }

  .faq-item.open .faq-icon {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  .faq-answer {
    height: 0;
    overflow: hidden;
    transition: height 300ms ease;
  }

  .faq-answer p {
    padding: 0 var(--space-6) var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.8;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-5);
  }

  .faq-cta {
    background-color: var(--color-dark);
    padding-block: var(--space-24);
  }

  .cta-inner {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  .cta-title {
    font-size: var(--text-3xl);
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .cta-desc {
    font-size: var(--text-base);
    color: #94a3b8;
    line-height: 1.7;
    margin-bottom: var(--space-8);
  }

  .cta-btns {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    background-color: var(--color-primary);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast);
  }

  .btn-primary:hover { background-color: var(--color-primary-hover); }

  .btn-secondary {
    display: inline-block;
    background-color: transparent;
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .btn-secondary:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.05);
  }
</style>