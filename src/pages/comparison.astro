---
import { getLang, useTranslations } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Shield, AlertTriangle, AlertCircle, Check, X } from "lucide-astro";

const base = import.meta.env.BASE_URL;
const lang = getLang(Astro.url, base);
const t = useTranslations(lang);
---

<BaseLayout t={t} lang={lang}>
  <main class="comparison-page">

    <!-- Hero -->
    <section class="page-hero">
      <div class="container">
        <div class="page-hero-inner reveal">
          <span class="page-label">{t.comparisonPage.label}</span>
          <h1 class="page-title">{t.comparisonPage.title}</h1>
          <p class="page-desc">{t.comparisonPage.desc}</p>
        </div>
      </div>
    </section>

    <!-- Cards -->
    <section class="cards-section">
      <div class="container">
        <div class="cards-grid">

          <!-- PUR -->
          <div class="material-card reveal">
            <div class="card-header">
              <div class="card-icon danger"><AlertTriangle size={22} /></div>
              <div>
                <h2 class="card-title">{t.comparisonPage.pur.name}</h2>
                <span class="card-rating danger">{t.comparisonPage.pur.rating}</span>
              </div>
            </div>
            <p class="card-desc">{t.comparisonPage.pur.desc}</p>
            <ul class="card-list">
              {t.comparisonPage.pur.pros.map((item: string) => (
                <li class="list-item success"><span class="list-icon"><Check size={14} /></span>{item}</li>
              ))}
              {t.comparisonPage.pur.cons.map((item: string) => (
                <li class="list-item danger"><span class="list-icon"><X size={14} /></span>{item}</li>
              ))}
            </ul>
          </div>

          <!-- PIR -->
          <div class="material-card reveal">
            <div class="card-header">
              <div class="card-icon warning"><AlertCircle size={22} /></div>
              <div>
                <h2 class="card-title">{t.comparisonPage.pir.name}</h2>
                <span class="card-rating warning">{t.comparisonPage.pir.rating}</span>
              </div>
            </div>
            <p class="card-desc">{t.comparisonPage.pir.desc}</p>
            <ul class="card-list">
              {t.comparisonPage.pir.pros.map((item: string) => (
                <li class="list-item success"><span class="list-icon"><Check size={14} /></span>{item}</li>
              ))}
              {t.comparisonPage.pir.cons.map((item: string) => (
                <li class="list-item danger"><span class="list-icon"><X size={14} /></span>{item}</li>
              ))}
            </ul>
          </div>

          <!-- Rockwool -->
          <div class="material-card featured reveal">
            <div class="featured-badge">{t.comparisonPage.rockwool.badge}</div>
            <div class="card-header">
              <div class="card-icon primary"><Shield size={22} /></div>
              <div>
                <h2 class="card-title primary">{t.comparisonPage.rockwool.name}</h2>
                <span class="card-rating primary">{t.comparisonPage.rockwool.rating}</span>
              </div>
            </div>
            <p class="card-desc">{t.comparisonPage.rockwool.desc}</p>
            <ul class="card-list">
              {t.comparisonPage.rockwool.pros.map((item: string) => (
                <li class="list-item success"><span class="list-icon"><Check size={14} /></span>{item}</li>
              ))}
            </ul>
          </div>

        </div>
      </div>
    </section>

    <!-- Comparison Table -->
    <section class="table-section">
      <div class="container">
        <div class="table-header reveal">
          <span class="section-label">{t.comparisonPage.table.label}</span>
          <h2 class="section-title">{t.comparisonPage.table.title}</h2>
        </div>
        <div class="table-wrapper reveal">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>{t.comparisonPage.table.feature}</th>
                <th>PUR</th>
                <th>PIR</th>
                <th class="col-featured">Rockwool</th>
              </tr>
            </thead>
            <tbody>
              {t.comparisonPage.table.rows.map((row: { feature: string; pur: string; pir: string; rockwool: string }) => (
                <tr>
                  <td class="feature-col">{row.feature}</td>
                  <td>{row.pur}</td>
                  <td>{row.pir}</td>
                  <td class="col-featured">{row.rockwool}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-inner reveal">
          <h2 class="cta-title">{t.comparisonPage.cta.title}</h2>
          <p class="cta-desc">{t.comparisonPage.cta.desc}</p>
          <div class="cta-buttons">
            <a href={lang === "es" ? `${base}/es/contact/` : `${base}/contact/`} class="btn-primary">
              {t.comparisonPage.cta.btnContact}
            </a>
            <a href={lang === "es" ? `${base}/es/performance/` : `${base}/performance/`} class="btn-secondary">
              {t.comparisonPage.cta.btnSpecs}
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .comparison-page { background-color: var(--color-bg); }

  /* Hero */
  .page-hero {
    background-color: var(--color-dark);
    padding-block: var(--space-24);
    padding-top: calc(var(--space-24) + var(--nav-height));
  }

  .page-hero-inner { max-width: 48rem; }

  .page-label {
    display: inline-block;
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    margin-bottom: var(--space-4);
    background-color: rgba(249, 115, 22, 0.1);
    border: 1px solid rgba(249, 115, 22, 0.2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  .page-title {
    font-size: var(--text-5xl);
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .page-desc {
    font-size: var(--text-lg);
    color: #94a3b8;
    line-height: 1.7;
  }

  /* Cards */
  .cards-section {
    padding-block: var(--space-24);
    background-color: var(--color-surface);
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) { .cards-grid { grid-template-columns: repeat(3, 1fr); } }

  .material-card {
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    position: relative;
    transition: box-shadow var(--transition-base);
  }

  .material-card:hover { box-shadow: var(--shadow-lg); }

  .material-card.featured {
    border-color: var(--color-primary);
    border-width: 2px;
    background-color: rgba(249, 115, 22, 0.02);
  }

  .featured-badge {
    position: absolute;
    top: -0.75rem;
    left: var(--space-6);
    background-color: var(--color-primary);
    color: #fff;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.2rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .card-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-icon.danger  { background-color: rgba(239, 68, 68, 0.1);  color: #ef4444; }
  .card-icon.warning { background-color: rgba(234, 179, 8, 0.1);  color: #eab308; }
  .card-icon.primary { background-color: rgba(249, 115, 22, 0.15); color: var(--color-primary); }

  .card-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .card-title.primary { color: var(--color-primary); }

  .card-rating {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .card-rating.danger  { color: #ef4444; }
  .card-rating.warning { color: #eab308; }
  .card-rating.primary { color: var(--color-primary); }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }

  .card-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .list-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .list-icon {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .list-item.success .list-icon { color: #22c55e; }
  .list-item.danger  .list-icon { color: #ef4444; }

  /* Table */
  .table-section {
    padding-block: var(--space-24);
    background-color: var(--color-bg);
  }

  .table-header {
    margin-bottom: var(--space-10);
  }

  .section-label {
    display: inline-block;
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    margin-bottom: var(--space-3);
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .table-wrapper {
    overflow-x: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    font-family: var(--font-mono);
  }

  .comparison-table thead {
    background-color: var(--color-dark);
    color: #fff;
  }

  .comparison-table th {
    padding: var(--space-4) var(--space-6);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-align: left;
  }

  .comparison-table th.col-featured { color: var(--color-primary); }

  .comparison-table tbody tr {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface);
    transition: background-color var(--transition-fast);
  }

  .comparison-table tbody tr:last-child { border-bottom: none; }
  .comparison-table tbody tr:hover { background-color: var(--color-surface-alt); }

  .comparison-table td {
    padding: var(--space-4) var(--space-6);
    color: var(--color-text-muted);
  }

  .comparison-table td.feature-col {
    font-weight: 700;
    color: var(--color-text);
    font-family: var(--font-sans);
  }

  .comparison-table td.col-featured {
    color: var(--color-primary);
    font-weight: 700;
  }

  /* CTA */
  .cta-section {
    padding-block: var(--space-24);
    background-color: var(--color-dark);
  }

  .cta-inner {
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
  }

  .cta-title {
    font-size: var(--text-4xl);
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .cta-desc {
    font-size: var(--text-base);
    color: #94a3b8;
    line-height: 1.7;
    margin-bottom: var(--space-8);
  }

  .cta-buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
  }

  @media (min-width: 640px) {
    .cta-buttons { flex-direction: row; justify-content: center; }
  }

  .btn-primary {
    display: inline-block;
    background-color: var(--color-primary);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast);
  }

  .btn-primary:hover { background-color: var(--color-primary-hover); }

  .btn-secondary {
    display: inline-block;
    background-color: transparent;
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-dark-border);
    transition: border-color var(--transition-fast);
  }

  .btn-secondary:hover { border-color: #fff; }
</style>