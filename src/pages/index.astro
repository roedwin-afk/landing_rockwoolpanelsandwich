---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import SpecsSection from "../components/sections/SpecsSection.astro";
import ComparisonSection from "../components/sections/ComparisonSection.astro";
import DownloadsSection from "../components/sections/DownloadsSection.astro";



import { getLang, useTranslations } from "../i18n/utils";

const base = import.meta.env.BASE_URL;
const lang = getLang(Astro.url, base);
const t = useTranslations(lang);
---

<BaseLayout t={t} lang={lang}>
  
  <main>
    <HeroSection t={t} lang={lang} />
    <SpecsSection t={t} lang={lang} />
    <ComparisonSection t={t} lang={lang} />
    <DownloadsSection t={t} lang={lang} />
  </main>
</BaseLayout>