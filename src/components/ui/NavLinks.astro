---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
  variant?: "navbar" | "footer" | "mobile";
}

const { t, lang, variant = "navbar" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const prefix = lang === "es" ? `${base}/es` : base;

const links = [
  { href: `${prefix}/performance/`, label: t.nav.performance },
  { href: `${prefix}/#specs`, label: t.nav.specs },
  { href: `${prefix}/#downloads`, label: t.nav.downloads },
  { href: `${prefix}/blog`, label: t.nav.blog },
];
---

<ul class={`nav-links nav-links--${variant}`}>
  {
    links.map((link) => (
      <li>
        <a href={link.href} class="nav-link">
          {link.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .nav-links {
    list-style: none;
  }

  /* Navbar variant */
  .nav-links--navbar {
    display: flex;
    align-items: center;
    gap: var(--space-10);
  }

  .nav-links--navbar .nav-link {
    position: relative;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    padding-bottom: var(--space-1);
    transition: color var(--transition-fast);
  }

  .nav-links--navbar .nav-link::after {
    content: "";
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0;
    left: 0;
    background-color: var(--color-primary);
    transition: width var(--transition-base);
  }

  .nav-links--navbar .nav-link:hover {
    color: var(--color-text);
  }

  .nav-links--navbar .nav-link:hover::after {
    width: 100%;
  }

  /* Footer variant */
  .nav-links--footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .nav-links--footer .nav-link {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
    transition: color var(--transition-fast);
  }

  .nav-links--footer .nav-link:hover {
    color: #ffffff;
  }

  /* Mobile variant */
  .nav-links--mobile {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .nav-links--mobile .nav-link {
    display: block;
    font-size: var(--text-base);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast);
  }

  .nav-links--mobile .nav-link:hover {
    background-color: var(--color-surface-alt);
  }
</style>