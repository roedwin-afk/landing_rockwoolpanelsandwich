---
import { FileText, FileCheck, FileCode, Calculator } from "lucide-astro";

interface Props {
  t: any;
  lang: string;
}

const { t, lang } = Astro.props;


const base = import.meta.env.BASE_URL;
const catalogFileName = lang === 'es' 
  ? 'catalogo-tecnico.pdf' 
  : 'technical-catalog.pdf';
const fireFileName = lang === 'es' 
  ? 'ficha-tecnica-EI240.pdf' 
  : 'technical-datasheet-EI240.pdf';

const catalogFileUrl = `${base}files/${catalogFileName}`;
const fireFileUrl = `${base}files/${fireFileName}`;
---


<section id="downloads" class="downloads-section">
  <div class="container">

    <div class="downloads-header reveal">
      <div class="header-text">
        <h2 class="section-title">{t.downloads.title}</h2>
        <p class="section-desc">{t.downloads.desc}</p>
      </div>
      <a href="#quote" class="portal-btn">
        {t.downloads.portalBtn}
        <span class="lock-icon">🔒</span>
      </a>
    </div>

    <div class="downloads-grid reveal">

        <a href={catalogFileUrl} download class="download-card" target="_blank" rel="noopener">
          <div class="file-icon pdf">
            <FileText size={28} />
          </div>
          <div class="file-info">
            <h4 class="file-name">{t.downloads.files.catalog.name}</h4>
            <span class="file-meta">{t.downloads.files.catalog.size}</span>
          </div>
          <span class="file-tag">PDF</span>
        </a>

        <a href={fireFileUrl} download class="download-card" target="_blank" rel="noopener">
          <div class="file-icon pdf">
            <FileText size={28} />
          </div>
          <div class="file-info">
            <h4 class="file-name">{t.downloads.files.fire.name}</h4>
            <span class="file-meta">{t.downloads.files.fire.size}</span>
          </div>
          <span class="file-tag">PDF</span>
        </a>

      <div class="download-card">
        <div class="file-icon cad">
          <FileCode size={28} />
        </div>
        <div class="file-info">
          <h4 class="file-name">{t.downloads.files.dwg.name}</h4>
          <span class="file-meta">{t.downloads.files.dwg.size}</span>
        </div>
        <span class="file-tag">DWG</span>
      </div>

      <div class="download-card">
        <div class="file-icon tool">
          <Calculator size={28} />
        </div>
        <div class="file-info">
          <h4 class="file-name">{t.downloads.files.tool.name}</h4>
          <span class="file-meta">{t.downloads.files.tool.size}</span>
        </div>
        <span class="file-tag">XLS</span>
      </div>

    </div>
  </div>
</section>

<style>
  .downloads-section {
    background-color: var(--color-surface);
    padding-block: var(--space-24);
  }

  /* Header */
  .downloads-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .downloads-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .section-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .portal-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-surface-alt);
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition: background-color var(--transition-fast);
  }

  .portal-btn:hover {
    background-color: var(--color-border);
  }

  .lock-icon {
    font-size: 0.75rem;
  }

  /* Grid */
  .downloads-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .downloads-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .downloads-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Card */
  .download-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .download-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  /* Icon */
  .file-icon {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .file-icon.pdf  { background-color: rgba(239, 68, 68, 0.1);  color: #ef4444; }
  .file-icon.cert { background-color: rgba(59, 130, 246, 0.1); color: #3b82f6; }
  .file-icon.cad  { background-color: rgba(100, 116, 139, 0.1); color: #64748b; }
  .file-icon.tool { background-color: rgba(249, 115, 22, 0.1); color: var(--color-primary); }

  /* Info */
  .file-info {
    flex: 1;
  }

  .file-name {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-1);
    line-height: 1.4;
  }

  .file-meta {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-subtle);
  }

  /* Tag */
  .file-tag {
    align-self: flex-start;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-subtle);
    background-color: var(--color-surface-alt);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
  }
</style>