---
import { FileText, FileCheck, FileCode, Calculator, X, Thermometer } from "lucide-astro";

interface Props {
  t: any;
  lang: string;
}

const { t, lang } = Astro.props;

const base = import.meta.env.BASE_URL;
const catalogFileName = lang === 'es' 
  ? 'catalogo-tecnico.pdf' 
  : 'technical-catalog.pdf';
const fireFileName = lang === 'es' 
  ? 'ficha-tecnica-EI240.pdf' 
  : 'technical-datasheet-EI240.pdf';

const dwgFileName = lang === 'es'
  ? 'detalles-instalacion.pdf'
  : 'installation-details.pdf';

const dwgFileUrl = `${base}files/${dwgFileName}`;

const catalogFileUrl = `${base}files/${catalogFileName}`;
const fireFileUrl = `${base}files/${fireFileName}`;


const labels = lang === 'es' ? {
  modalTitle: "Calculadora de U-Value",
  thickness: "Espesor del panel",
  lambda: "Conductividad térmica λ",
  tempInt: "Temperatura interior",
  tempExt: "Temperatura exterior",
  usage: "Tipo de uso",
  usages: ["Industrial", "Refrigeración", "Sala limpia", "Edificio público"],
  calculate: "Calcular",
  results: "Resultados",
  uvalue: "U-Value",
  resistance: "Resistencia térmica R",
  delta: "Diferencia ΔT",
  recommendation: "Recomendación",
  close: "Cerrar",
} : {
  modalTitle: "U-Value Calculator",
  thickness: "Panel thickness",
  lambda: "Thermal conductivity λ",
  tempInt: "Indoor temperature",
  tempExt: "Outdoor temperature",
  usage: "Usage type",
  usages: ["Industrial", "Cold storage", "Clean room", "Public building"],
  calculate: "Calculate",
  results: "Results",
  uvalue: "U-Value",
  resistance: "Thermal resistance R",
  delta: "Temperature difference ΔT",
  recommendation: "Recommendation",
  close: "Close",
};
---

<section id="downloads" class="downloads-section">
  <div class="container">

    <div class="downloads-header reveal">
      <div class="header-text">
        <h2 class="section-title">{t.downloads.title}</h2>
        <p class="section-desc">{t.downloads.desc}</p>
      </div>
      <!-- <div class="portal-btn">
        {t.downloads.portalBtn}
        <span class="lock-icon">🔒</span>
      </div> -->
    </div>

    <div class="downloads-grid reveal">

      <a href={catalogFileUrl} download class="download-card" target="_blank" rel="noopener">
        <div class="file-icon pdf"><FileText size={28} /></div>
        <div class="file-info">
          <h4 class="file-name">{t.downloads.files.catalog.name}</h4>
          <span class="file-meta">{t.downloads.files.catalog.size}</span>
        </div>
        <span class="file-tag">PDF</span>
      </a>

      <a href={fireFileUrl} download class="download-card" target="_blank" rel="noopener">
        <div class="file-icon pdf"><FileText size={28} /></div>
        <div class="file-info">
          <h4 class="file-name">{t.downloads.files.fire.name}</h4>
          <span class="file-meta">{t.downloads.files.fire.size}</span>
        </div>
        <span class="file-tag">PDF</span>
      </a>

      <a href={dwgFileUrl} download class="download-card" target="_blank" rel="noopener">
        <div class="file-icon cad"><FileCode size={28} /></div>
        <div class="file-info">
          <h4 class="file-name">{t.downloads.files.dwg.name}</h4>
          <span class="file-meta">{t.downloads.files.dwg.size}</span>
        </div>
        <span class="file-tag">DWG</span>
      </a>

      <button id="open-calculator" class="download-card download-card--btn">
        <div class="file-icon tool"><Calculator size={28} /></div>
        <div class="file-info">
          <h4 class="file-name">{t.downloads.files.tool.name}</h4>
          <span class="file-meta">{t.downloads.files.tool.size}</span>
        </div>
        <span class="file-tag file-tag--primary">CALC</span>
      </button>

    </div>
  </div>
</section>

<!-- Modal -->
<div id="calc-modal" class="modal" aria-hidden="true">
  <div class="modal__backdrop"></div>
  <div class="modal__panel" role="dialog" aria-modal="true">

    <div class="modal__header">
      <div class="modal__title-group">
        <div class="modal__icon"><Calculator size={20} color="white" /></div>
        <h2 class="modal__title">{labels.modalTitle}</h2>
      </div>
      <button id="close-calculator" class="modal__close" aria-label="Close">
        <X size={20} />
      </button>
    </div>

    <div class="modal__body">
      <div class="calc-form">

        <!-- Thickness slider -->
        <div class="field">
          <label class="field__label">
            {labels.thickness}
            <span class="field__value" id="thickness-display">100 mm</span>
          </label>
          <input
            type="range"
            id="thickness"
            min="50"
            max="200"
            step="10"
            value="100"
            class="slider"
          />
          <div class="slider-ticks">
            <span>50</span><span>80</span><span>100</span><span>120</span>
            <span>150</span><span>180</span><span>200</span>
          </div>
        </div>

        <!-- Lambda -->
        <div class="field">
          <label class="field__label" for="lambda">
            {labels.lambda} (W/m·K)
          </label>
          <input
            type="number"
            id="lambda"
            value="0.040"
            min="0.030"
            max="0.050"
            step="0.001"
            class="input"
          />
        </div>

        <!-- Temperatures -->
        <div class="field-row">
          <div class="field">
            <label class="field__label" for="temp-int">
              {labels.tempInt} (°C)
            </label>
            <input type="number" id="temp-int" value="20" class="input" />
          </div>
          <div class="field">
            <label class="field__label" for="temp-ext">
              {labels.tempExt} (°C)
            </label>
            <input type="number" id="temp-ext" value="-5" class="input" />
          </div>
        </div>

        <!-- Usage type -->
        <div class="field">
          <label class="field__label">{labels.usage}</label>
          <div class="usage-grid">
            {labels.usages.map((u, i) => (
              <label class="usage-option">
                <input type="radio" name="usage" value={i} checked={i === 0} />
                <span class="usage-label">{u}</span>
              </label>
            ))}
          </div>
        </div>

        <button id="calc-btn" class="calc-btn">
          {labels.calculate}
        </button>
      </div>

      <!-- Results -->
      <div class="results" id="calc-results" aria-live="polite">
        <h3 class="results__title">{labels.results}</h3>

        <div class="results-grid">
          <div class="result-card">
            <span class="result-label">{labels.uvalue}</span>
            <span class="result-value" id="result-uvalue">—</span>
            <span class="result-unit">W/m²K</span>
          </div>
          <div class="result-card">
            <span class="result-label">{labels.resistance}</span>
            <span class="result-value" id="result-r">—</span>
            <span class="result-unit">m²K/W</span>
          </div>
          <div class="result-card">
            <span class="result-label">{labels.delta}</span>
            <span class="result-value" id="result-delta">—</span>
            <span class="result-unit">°C</span>
          </div>
        </div>

        <div class="recommendation" id="calc-recommendation"></div>
      </div>
    </div>

  </div>
</div>

<style>
  /* ── Downloads section (unchanged) ── */
  .downloads-section {
    background-color: var(--color-surface);
    padding-block: var(--space-24);
  }

  .downloads-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .downloads-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .section-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .portal-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-surface-alt);
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition: background-color var(--transition-fast);
  }

  .portal-btn:hover { background-color: var(--color-border); }
  .lock-icon { font-size: 0.75rem; }

  .downloads-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) { .downloads-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .downloads-grid { grid-template-columns: repeat(4, 1fr); } }

  .download-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    text-align: left;
    background: none;
    width: 100%;
  }

  .download-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .download-card--btn:hover .file-icon.tool {
    background-color: rgba(249, 115, 22, 0.2);
  }

  .file-icon {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--transition-fast);
  }

  .file-icon.pdf  { background-color: rgba(239, 68, 68, 0.1);  color: #ef4444; }
  .file-icon.cad  { background-color: rgba(100, 116, 139, 0.1); color: #64748b; }
  .file-icon.tool { background-color: rgba(249, 115, 22, 0.1); color: var(--color-primary); }

  .file-info { flex: 1; }

  .file-name {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-1);
    line-height: 1.4;
  }

  .file-meta {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-subtle);
  }

  .file-tag {
    align-self: flex-start;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-subtle);
    background-color: var(--color-surface-alt);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
  }

  .file-tag--primary {
    color: var(--color-primary);
    background-color: rgba(249, 115, 22, 0.1);
  }

  /* ── Modal ── */
  .modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
  }

  .modal.is-open { display: flex; align-items: center; justify-content: center; }

  .modal__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / 0.6);
    backdrop-filter: blur(4px);
    animation: fadeIn var(--transition-base) ease forwards;
  }

  .modal__panel {
    position: relative;
    z-index: 1;
    background-color: var(--color-surface);
    border-radius: var(--radius-xl);
    width: min(56rem, calc(100% - 2rem));
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    box-shadow: 0 25px 60px rgb(0 0 0 / 0.3);
    animation: slideUp var(--transition-base) ease forwards;
  }

  .modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-6) var(--space-8);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    background-color: var(--color-surface);
    z-index: 1;
  }

  .modal__title-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .modal__icon {
    background-color: var(--color-primary);
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .modal__title {
    font-size: var(--text-xl);
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .modal__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .modal__close:hover {
    background-color: var(--color-surface-alt);
    color: var(--color-text);
  }

  .modal__body {
    padding: var(--space-8);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .modal__body { grid-template-columns: 1fr 1fr; }
  }

  /* ── Form ── */
  .calc-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .field { display: flex; flex-direction: column; gap: var(--space-2); }

  .field__label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .field__value {
    font-family: var(--font-mono);
    color: var(--color-primary);
    font-weight: 700;
  }

  .input {
    width: 100%;
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text);
    transition: border-color var(--transition-fast);
  }

  .input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  /* Slider */
  .slider {
    width: 100%;
    accent-color: var(--color-primary);
    height: 0.375rem;
    cursor: pointer;
  }

  .slider-ticks {
    display: flex;
    justify-content: space-between;
    font-size: 0.625rem;
    font-family: var(--font-mono);
    color: var(--color-text-subtle);
    font-weight: 600;
    margin-top: var(--space-1);
  }

  /* Usage grid */
  .usage-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  .usage-option {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
  }

  .usage-option input[type="radio"] {
    accent-color: var(--color-primary);
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .usage-label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .usage-option:has(input:checked) .usage-label {
    color: var(--color-primary);
    font-weight: 700;
  }

  /* Calc button */
  .calc-btn {
    width: 100%;
    background-color: var(--color-primary);
    color: white;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
    margin-top: var(--space-2);
  }

  .calc-btn:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-1px);
  }

  /* ── Results ── */
  .results {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    background-color: var(--color-dark);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    color: white;
  }

  .results__title {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #64748b;
  }

  .results-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 480px) {
    .results-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .result-card {
    background-color: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .result-label {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #64748b;
  }

  .result-value {
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--color-primary);
    font-family: var(--font-mono);
    line-height: 1;
  }

  .result-unit {
    font-size: var(--text-xs);
    color: #475569;
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .recommendation {
    background-color: rgba(249, 115, 22, 0.1);
    border: 1px solid rgba(249, 115, 22, 0.2);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    font-size: var(--text-sm);
    color: #fdba74;
    line-height: 1.6;
    display: none;
  }

  .recommendation.is-visible { display: block; }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(1rem); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  // Recommendations per usage type (index matches labels.usages order)
  const recommendations: Record<string, Record<number, { en: string; es: string }>> = {
    good: {
      0: { en: "✓ Suitable for industrial use. U-Value meets standard energy requirements.", es: "✓ Adecuado para uso industrial. El U-Value cumple los requisitos energéticos estándar." },
      1: { en: "✓ Good performance for cold storage. Consider thicker panels for deep freeze applications.", es: "✓ Buen rendimiento para refrigeración. Considera paneles más gruesos para congelación profunda." },
      2: { en: "✓ Meets clean room thermal requirements.", es: "✓ Cumple los requisitos térmicos de sala limpia." },
      3: { en: "✓ Compliant with public building energy regulations.", es: "✓ Cumple con la normativa energética de edificios públicos." },
    },
    improve: {
      0: { en: "⚠ Consider increasing thickness to 100mm+ for better energy efficiency.", es: "⚠ Considera aumentar el espesor a 100mm+ para mejor eficiencia energética." },
      1: { en: "⚠ For cold storage, a minimum of 120mm is recommended.", es: "⚠ Para refrigeración, se recomienda un mínimo de 120mm." },
      2: { en: "⚠ Increase panel thickness for clean room standards (min. 100mm).", es: "⚠ Aumenta el espesor para cumplir estándares de sala limpia (mín. 100mm)." },
      3: { en: "⚠ Public buildings require lower U-Values. Consider 150mm+ panels.", es: "⚠ Los edificios públicos requieren U-Values más bajos. Considera paneles de 150mm+." },
    },
  };

  // U-Value thresholds per usage type
  const thresholds = [0.50, 0.30, 0.35, 0.25];

  function initCalculator() {
    const modal     = document.getElementById("calc-modal");
    const openBtn   = document.getElementById("open-calculator");
    const closeBtn  = document.getElementById("close-calculator");
    const backdrop  = modal?.querySelector(".modal__backdrop");
    const slider    = document.getElementById("thickness") as HTMLInputElement;
    const display   = document.getElementById("thickness-display");
    const calcBtn   = document.getElementById("calc-btn");

    if (!modal || !openBtn || !closeBtn || !slider) return;

    // Open / close
    function open()  { modal!.classList.add("is-open");    modal!.setAttribute("aria-hidden", "false"); document.body.style.overflow = "hidden"; }
    function close() { modal!.classList.remove("is-open"); modal!.setAttribute("aria-hidden", "true");  document.body.style.overflow = ""; }

    openBtn.addEventListener("click", open);
    closeBtn.addEventListener("click", close);
    backdrop?.addEventListener("click", close);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });

    // Slider display
    slider.addEventListener("input", () => {
      if (display) display.textContent = `${slider.value} mm`;
    });

    // Calculate
    calcBtn?.addEventListener("click", () => {
      const thickness = parseFloat(slider.value) / 1000; // m
      const lambda    = parseFloat((document.getElementById("lambda") as HTMLInputElement).value);
      const tempInt   = parseFloat((document.getElementById("temp-int") as HTMLInputElement).value);
      const tempExt   = parseFloat((document.getElementById("temp-ext") as HTMLInputElement).value);
      const usageEl   = document.querySelector('input[name="usage"]:checked') as HTMLInputElement;
      const usage     = usageEl ? parseInt(usageEl.value) : 0;

      // R total = R_si + R_core + R_se (interior/exterior surface resistances)
      const R_si   = 0.13;
      const R_se   = 0.04;
      const R_core = thickness / lambda;
      const R_total = R_si + R_core + R_se;
      const U      = 1 / R_total;
      const delta  = Math.abs(tempInt - tempExt);

      // Detect lang from html element
      const lang = document.documentElement.lang === "es" ? "es" : "en";

      // Update results
      (document.getElementById("result-uvalue") as HTMLElement).textContent = U.toFixed(3);
      (document.getElementById("result-r") as HTMLElement).textContent = R_total.toFixed(3);
      (document.getElementById("result-delta") as HTMLElement).textContent = delta.toFixed(1);

      // Recommendation
      const rec    = document.getElementById("calc-recommendation") as HTMLElement;
      const isGood = U <= thresholds[usage];
      const key    = isGood ? "good" : "improve";
      rec.textContent  = recommendations[key][usage][lang];
      rec.classList.add("is-visible");

      // Highlight U-value card
      const uCard = document.getElementById("result-uvalue")!;
      uCard.style.color = isGood ? "#4ade80" : "#fb923c";
    });
  }

  document.addEventListener("astro:page-load", initCalculator);
</script>