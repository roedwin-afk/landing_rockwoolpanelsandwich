---
import { Shield, AlertTriangle, AlertCircle } from "lucide-astro";

interface Props {
  t: any;
  lang: string;
}

const { t } = Astro.props;
---

<section id="comparison" class="comparison-section">
  <div class="container">

    <div class="section-header reveal">
      <span class="section-label">{t.comparison.label}</span>
      <h2 class="section-title">{t.comparison.title}</h2>
    </div>

    <div class="comparison-grid reveal">

      <!-- PUR -->
      <div class="comparison-card">
        <div class="card-icon danger">
          <AlertTriangle size={24} />
        </div>
        <h3 class="card-name">{t.comparison.pur.name}</h3>
        <p class="card-desc">{t.comparison.pur.desc}</p>
        <div class="metrics">
          <div class="metric">
            <div class="metric-header">
              <span class="metric-label">{t.comparison.metrics.fire}</span>
              <span class="metric-value danger">{t.comparison.pur.fire}</span>
            </div>
            <div class="bar-track"><div class="bar-fill danger" style="width: 25%"></div></div>
          </div>
          <div class="metric">
            <div class="metric-header">
              <span class="metric-label">{t.comparison.metrics.thermal}</span>
              <span class="metric-value success">{t.comparison.pur.thermal}</span>
            </div>
            <div class="bar-track"><div class="bar-fill success" style="width: 100%"></div></div>
          </div>
        </div>
      </div>

      <!-- PIR -->
      <div class="comparison-card">
        <div class="card-icon warning">
          <AlertCircle size={24} />
        </div>
        <h3 class="card-name">{t.comparison.pir.name}</h3>
        <p class="card-desc">{t.comparison.pir.desc}</p>
        <div class="metrics">
          <div class="metric">
            <div class="metric-header">
              <span class="metric-label">{t.comparison.metrics.fire}</span>
              <span class="metric-value warning">{t.comparison.pir.fire}</span>
            </div>
            <div class="bar-track"><div class="bar-fill warning" style="width: 55%"></div></div>
          </div>
          <div class="metric">
            <div class="metric-header">
              <span class="metric-label">{t.comparison.metrics.thermal}</span>
              <span class="metric-value success">{t.comparison.pir.thermal}</span>
            </div>
            <div class="bar-track"><div class="bar-fill success" style="width: 92%"></div></div>
          </div>
        </div>
      </div>

      <!-- ROCKWOOL — destacado -->
      <div class="comparison-card featured">
        <div class="featured-badge">{t.comparison.rockwool.badge}</div>
        <div class="card-icon primary">
          <Shield size={24} />
        </div>
        <h3 class="card-name primary">{t.comparison.rockwool.name}</h3>
        <p class="card-desc light">{t.comparison.rockwool.desc}</p>
        <div class="metrics">
          <div class="metric">
            <div class="metric-header">
              <span class="metric-label">{t.comparison.metrics.fire}</span>
              <span class="metric-value primary">{t.comparison.rockwool.fire}</span>
            </div>
            <div class="bar-track"><div class="bar-fill primary" style="width: 100%"></div></div>
          </div>
          <div class="metric">
            <div class="metric-header">
              <span class="metric-label">{t.comparison.metrics.acoustic}</span>
              <span class="metric-value primary">{t.comparison.rockwool.acoustic}</span>
            </div>
            <div class="bar-track"><div class="bar-fill primary" style="width: 100%"></div></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .comparison-section {
    background-color: var(--color-dark);
    padding-block: var(--space-24);
    color: #fff;
  }

  /* Header */
  .section-header {
    text-align: center;
    margin-bottom: var(--space-16);
  }

  .section-label {
    display: inline-block;
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    margin-bottom: var(--space-4);
  }

  .section-title {
    font-size: var(--text-4xl);
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1.15;
    max-width: 40rem;
    margin-inline: auto;
  }

  /* Grid */
  .comparison-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 1px solid var(--color-dark-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .comparison-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Card */
  .comparison-card {
    padding: var(--space-10);
    border-bottom: 1px solid var(--color-dark-border);
    transition: background-color var(--transition-base);
    position: relative;
  }

  .comparison-card:last-child {
    border-bottom: none;
  }

  @media (min-width: 768px) {
    .comparison-card {
      border-bottom: none;
      border-right: 1px solid var(--color-dark-border);
    }

    .comparison-card:last-child {
      border-right: none;
    }

    .comparison-card:hover:not(.featured) {
      background-color: var(--color-dark-surface);
    }
  }

  .comparison-card.featured {
    background-color: rgba(249, 115, 22, 0.08);
    border-left: 4px solid var(--color-primary);
  }

  /* Badge */
  .featured-badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background-color: var(--color-primary);
    color: #fff;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }

  /* Icon */
  .card-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-5);
  }

  .card-icon.danger  { background-color: rgba(239, 68, 68, 0.15);  color: #ef4444; }
  .card-icon.warning { background-color: rgba(234, 179, 8, 0.15);   color: #eab308; }
  .card-icon.primary { background-color: rgba(249, 115, 22, 0.2);   color: var(--color-primary); }

  /* Text */
  .card-name {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-3);
  }

  .card-name.primary { color: var(--color-primary); }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    line-height: 1.6;
    margin-bottom: var(--space-8);
    min-height: 4.5rem;
  }

  .card-desc.light { color: #cbd5e1; }

  /* Metrics */
  .metrics { display: flex; flex-direction: column; gap: var(--space-5); }

  .metric-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .metric-label {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .metric-value {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metric-value.danger  { color: #ef4444; }
  .metric-value.warning { color: #eab308; }
  .metric-value.success { color: #22c55e; }
  .metric-value.primary { color: var(--color-primary); }

  /* Bars */
  .bar-track {
    width: 100%;
    height: 0.375rem;
    background-color: var(--color-dark-border);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width 1s ease;
  }

  .bar-fill.danger  { background-color: #ef4444; }
  .bar-fill.warning { background-color: #eab308; }
  .bar-fill.success { background-color: #22c55e; }
  .bar-fill.primary { background-color: var(--color-primary); }
</style>